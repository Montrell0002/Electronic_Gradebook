    private boolean final_5=false;
    private void grades_1(){
        if (final_1) return;
        DefaultListModel<String> model = new DefaultListModel<>();
    model.clear();
    try {
    Connection con = DriverManager.getConnection(
        "jdbc:mysql://localhost:3306/ms.carter_db",
        "root",
        "password"
    );

    String sql = "SELECT first_name, last_name, SUM(category_weighted_score) AS final_grade FROM (SELECT s.student_id, s.first_name, s.last_name, gc.category_name, (SUM(g.points_earned) / SUM(a.max_points)) * (gc.weight_percentage/100) AS category_weighted_score FROM grade_category gc JOIN assignment a ON gc.category_id = a.category_id JOIN submission sub ON a.assignment_id = sub.assignment_id JOIN grades g ON sub.submission_id = g.submission_id JOIN students s ON sub.student_id = s.student_id JOIN student_class sc ON sc.student_id= s.student_id WHERE sc.class_id=1 GROUP BY s.student_id, s.first_name, s.last_name, gc.category_name, gc.weight_percentage) AS category_scores GROUP BY student_id, first_name, last_name";
    PreparedStatement pst = con.prepareStatement(sql);
    ResultSet rs = pst.executeQuery();

    while (rs.next()) {
        double finalGrade1 = rs.getDouble("final_grade") * 100;
        String fgrade = rs.getString("first_name") + " " + rs.getString("last_name")+" "+ String.format("%.2f", finalGrade1) ;
        model.addElement(fgrade);
        
    }
    jList1.setModel(model);
    final_1=true;
    

} catch (Exception e) {
    e.printStackTrace();
}
        
    }
